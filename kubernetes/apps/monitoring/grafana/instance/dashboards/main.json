    {
      "id": 17,
      "type": "table",
      "title": "OSD fill",
      "description": "Per-OSD utilisation, fullest first. Thresholds track Ceph's own gates: 85% is nearfull_ratio (cluster goes HEALTH_WARN with OSD_NEARFULL), 95% is full_ratio (that OSD stops accepting writes and the pools go read-only). OSDs here range 0.5-3.84TiB and fill very unevenly, so the fullest OSD - not the cluster average - is what actually limits writes; see the usable-free panel for what that leaves you. PG counts are uneven by design: one PG carries a manual upmap to compensate for tiny being an undersized failure domain.",
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "max by(ceph_daemon, hostname) (100 * ceph_osd_stat_bytes_used / ceph_osd_stat_bytes * on(ceph_daemon) group_left(hostname) ceph_osd_metadata)",
          "refId": "A",
          "format": "table",
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "max by(ceph_daemon) (ceph_osd_stat_bytes_used)",
          "refId": "B",
          "format": "table",
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "max by(ceph_daemon) (ceph_osd_stat_bytes)",
          "refId": "C",
          "format": "table",
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "max by(ceph_daemon) (ceph_osd_numpg)",
          "refId": "D",
          "format": "table",
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "max by(ceph_daemon) (ceph_osd_apply_latency_ms)",
          "refId": "E",
          "format": "table",
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "max by(ceph_daemon) (ceph_osd_up * on(ceph_daemon) group_left() (1 + ceph_osd_in))",
          "refId": "F",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          },
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
