    {
      "id": 18,
      "type": "timeseries",
      "title": "Ceph usable free space",
      "description": "max_avail: bytes a replicated pool can still take, as Ceph computes it from the actual CRUSH layout. This is the number that matters and it is much smaller than (raw total - raw used) / 3, because the fullest OSD in the smallest failure domain caps it. Plotted rather than reduced to an ETA on purpose: the slope is what tells you how long you have, and you can see how noisy it is instead of trusting a fitted number.",
      "gridPos": {
        "x": 12,
        "y": 31,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "max(ceph_pool_max_avail)",
          "refId": "A",
          "legendFormat": "usable free"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "sum(ceph_pool_stored)",
          "refId": "B",
          "legendFormat": "stored"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 19,
      "type": "table",
      "title": "Ceph health checks",
      "description": "The named checks behind the Ceph Health stat up top. Empty means HEALTH_OK. RECENT_CRASH sticks around until the crash is archived (`ceph crash archive-all`), so it is the usual reason for a warn that has no live symptom.",
      "gridPos": {
        "x": 0,
        "y": 39,
        "w": 24,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
