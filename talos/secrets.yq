[
  {
    "machine": {"token": .trustdinfo.token, "ca": .certs.os},
    "cluster": {
      "token": .secrets.bootstraptoken,
      "etcd": {"ca": .certs.etcd}
    }
  },
  {
    "apiVersion": "v1alpha1", "kind": "KubeAPIServerCAConfig",
    "issuingCA": {"cert": (.certs.k8s.crt | @base64d), "key": (.certs.k8s.key | @base64d)}
  },
  {
    "apiVersion": "v1alpha1", "kind": "KubeAggregatorCAConfig",
    "issuingCA": {"cert": (.certs.k8saggregator.crt | @base64d), "key": (.certs.k8saggregator.key | @base64d)}
  },
  {
    "apiVersion": "v1alpha1", "kind": "KubeEtcdEncryptionConfig",
    "config": {"resources": [{
      "resources": ["secrets"],
      "providers": [
        {"secretbox": {"keys": [{"name": "key2", "secret": .secrets.secretboxencryptionsecret}]}},
        {"identity": {}}
      ]
    }]}
  },
  {
    "apiVersion": "v1alpha1", "kind": "KubeServiceAccountConfig",
    "issuer": {"privateKey": (.certs.k8sserviceaccount.key | @base64d)}
  },
  {
    "apiVersion": "v1alpha1", "kind": "DiscoveryIdentityConfig",
    "clusterID": .cluster.id, "clusterSecret": .cluster.secret
  }
] | .[] | split_doc
