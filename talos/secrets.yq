{
  "machine": {"token": .trustdinfo.token, "ca": .certs.os},
  "cluster": {
    "id": .cluster.id, "secret": .cluster.secret,
    "token": .secrets.bootstraptoken,
    "secretboxEncryptionSecret": .secrets.secretboxencryptionsecret,
    "ca": .certs.k8s, "aggregatorCA": .certs.k8saggregator,
    "serviceAccount": {"key": .certs.k8sserviceaccount.key},
    "etcd": {"ca": .certs.etcd}
  }
}
